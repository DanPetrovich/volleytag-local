.venv-vision/
vision/runs/
/runs/

# External sports datasets, extracted frames, and downloaded checkpoints stay
# local even if a tool is pointed outside the normal vision/runs workspace.
vision/data/
vision/external/

# Local source registries can contain direct match URLs and stay private.
vision/match-registry-*.json
vision/*.pt
yolo*.pt
models/
*.npy
*.joblib
__pycache__/
*.py[cod]
.DS_Store
.env
.env.*
*.pem
*.key
credentials*.json

# Photos, screenshots, and extracted dataset frames stay local. Add a reviewed
# non-private UI asset explicitly with `git add -f` only when it is intentional.
*.jpg
*.jpeg
*.png
*.webp
*.heic

# Generated inputs/outputs for remote experiments. Kernel source and metadata
# stay versioned; caches and downloaded artifacts do not.
vision/kaggle/**/candidates.json
vision/kaggle/**/candidates.json.gz
vision/kaggle/**/output/

# Match video and user exports
*.mp4
*.mov
*.mkv
*.webm
*-events.csv
*-backup.json
config.local.js
.groq-key
volleytag-voice*.log

# Local source registries can identify private matches or storage locations.
vision/match-registry*.json

